DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Secreto para firmar los tokens. Mínimo 32 caracteres o el servidor no arranca. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_EXIGIR_ORIGEN=false

# ---------- Límite de intentos (login y registro) ----------
# Intentos FALLIDOS de inicio de sesión permitidos por IP y correo (por defecto 5)...
RATE_LIMIT_LOGIN_MAX=5
# ...en esta ventana de minutos (por defecto 15). El registro admite 10 por IP cada hora.
RATE_LIMIT_VENTANA_MIN=15
# true apaga el límite. Úsalo para correr Cypress, que crea muchos usuarios seguidos.
# (Con NODE_ENV=test, como en Jest, ya está apagado.)
RATE_LIMIT_DESACTIVADO=false

# ---------- Publicación ----------
# true cuando la app corre detrás del proxy HTTPS de un hosting (Render, Railway...):
# así Express ve la IP real del visitante y el límite de intentos funciona por persona.
TRUST_PROXY=false
